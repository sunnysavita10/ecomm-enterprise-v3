ENVIRONMENT=development
AUTH_MODE=dev
DEV_USER_ID=local-user
DATABASE_URL=postgresql+asyncpg://ecomm:ecomm@localhost:5432/ecomm
REDIS_URL=redis://localhost:6379/0
RETRIEVAL_MODE=demo
DEMO_CATALOG_PATH=data/products.csv
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=
ASTRA_COLLECTION=ecommercedata
CORS_ORIGINS=http://localhost:3000
# Production: ENVIRONMENT=production AUTH_MODE=jwks RETRIEVAL_MODE=astra
# JWT_ISSUER= JWT_AUDIENCE= JWKS_URL=

# Optional provider fallback and metrics integrations
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER_ORDER=openai,groq
PROVIDER_RETRIES=1
CIRCUIT_BREAKER_THRESHOLD=3
HYBRID_ENABLED=true
OTLP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
INGEST_ROOT=data
